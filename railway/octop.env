HOME="/data"
PORT="8088"
OCTOP_PORT="8088"
OCTOP_BIND_HOST="0.0.0.0"
OCTOP_LOG_LEVEL="info"
OCTOP_ADMIN_USERNAME="admin"
OCTOP_ADMIN_DISPLAY_NAME="Admin"
OCTOP_DEFAULT_PASSWORD="Oc7${{secret(24)}}"
OCTOP_DATABASE_DRIVER="postgresql"
OCTOP_DATABASE_URL="${{Postgres.DATABASE_URL}}"
OCTOP_DEFAULT_TIMEZONE="UTC"
OCTOP_CORS_ORIGINS="https://${{RAILWAY_PUBLIC_DOMAIN}}"
OCTOP_MAX_UPLOAD_MB="100"
OCTOP_ENABLE_API_DOCS="false"
LANGFUSE_TRACING_ENABLED="false"
RAILWAY_DEPLOYMENT_DRAINING_SECONDS="30"
